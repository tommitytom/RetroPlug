{
	"name": "RetroPlug",

	"build": {
		"dockerfile": "Dockerfile",
		"args": {
			"CONTAINER_APT_PROXY": "${localEnv:CONTAINER_APT_PROXY}"
		}
	},

	"mounts": [
		// Wayland
		"source=/run/user/1000/wayland-1,target=/run/user/1000/wayland-1,type=bind",
		// X11 fallback
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
		// Audio
		"source=/run/user/1000/pipewire-0,target=/run/user/1000/pipewire-0,type=bind",
		"source=/run/user/1000/pulse,target=/run/user/1000/pulse,type=bind",

		"source=${localEnv:HOME}/retro,target=/workspaces/retro,type=bind"
	],
	"containerEnv": {
		"WAYLAND_DISPLAY": "wayland-1",
		"DISPLAY": ":0",
		"XDG_RUNTIME_DIR": "/run/user/1000",
		"PIPEWIRE_REMOTE": "/run/user/1000/pipewire-0",
		"PULSE_SERVER": "unix:/run/user/1000/pulse/native"
	},

	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt",
		"seccomp=unconfined",
		"--net=host"
	],

	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.shell.linux": "/bin/zsh"
			},
			"extensions": [
				"dbaeumer.vscode-eslint",
				"ms-vscode.cpptools",
				"dtsvet.vscode-wasm",
				"firefox-devtools.vscode-firefox-debug",
				"ms-edgedevtools.vscode-edge-devtools",
				"mutantdino.resourcemonitor",
				"sumneko.lua",
				"mhutchie.git-graph"
			]
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		1338
	],

	// Comment out connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
	"remoteUser": "ubuntu"
}
