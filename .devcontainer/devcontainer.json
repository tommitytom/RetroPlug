{
  "name": "RetroPlug2",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CONTAINER_APT_PROXY": "${localEnv:CONTAINER_APT_PROXY}"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "none",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false
    }
  },
  // Claude Code state lives in /workspaces/.claude on the host (the workspace
  // bind mount one level above the repo), so it survives rebuilds without a
  // Docker volume. post-create.sh symlinks ~/.claude and ~/.claude.json to it.
  "containerEnv": {
    "TZ": "${localEnv:TZ}"
  },
  // Pass through the physical hardware attached to the host so agents can drive + observe it:
  //   --device=/dev/ttyACM0          the Everdrive N8 Pro's USB-serial port (VID:PID 38df:0017,
  //                                  cdc_acm on the host) -> `retroplug-cli n8-bridge`.
  //   --device=/dev/snd              all ALSA cards, incl. the Zoom L6 (card id "L6"); the 2A03
  //                                  audio lands on USB capture channels 3-4 -> `arecord -D hw:L6`.
  //   --device=/dev/video0 / video1  the MacroSilicon USB capture card carrying the NES video feed
  //                                  (uvcvideo) -> `ffmpeg -f v4l2 -i /dev/video0 ...` frame grabs.
  // These nodes come in root-owned; postStartCommand opens them to the vscode user. If a device is
  // absent (e.g. N8 unplugged) the container start fails on the missing --device, so unplugging
  // means temporarily removing that line + rebuilding.
  //
  // Raw USB passthrough (to flash / drive RP2040 boards such as the Raspberry Pi Debug Probe,
  // VID:PID 2e8a:000c, over SWD with OpenOCD): bind-mount the whole /dev/bus/usb tree + grant the
  // USB (major 189) and tty-ACM (major 166) device-cgroup rules. Unlike --device this is a directory
  // mount, so it does NOT hard-fail when a board is absent and it stays live across replug.
  // hw-usb-perms.sh (postStart) then opens the usb nodes to the user and exposes the probe's dynamic
  // CDC console under a stable /dev/ttyDbgProbe. See pico/README.md.
  "runArgs": [
    "--init",
    "--shm-size=512m",
    "--ulimit",
    "memlock=-1:-1",
    "--device=/dev/ttyACM0",
    "--device=/dev/snd",
    "--device=/dev/video0",
    "--device=/dev/video1",
    "--mount=type=bind,source=/dev/bus/usb,target=/dev/bus/usb",
    "--device-cgroup-rule=c 189:* rmw",
    "--device-cgroup-rule=c 166:* rmw"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sudo chmod a+rw /dev/ttyACM0 /dev/video0 /dev/video1 2>/dev/null; sudo chmod -R a+rw /dev/snd 2>/dev/null; bash .devcontainer/hw-usb-perms.sh 2>/dev/null; true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "anthropic.claude-code",
        "ms-python.python"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "cmake.generator": "Unix Makefiles"
      }
    }
  }
}