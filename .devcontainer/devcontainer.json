{
  "name": "RetroPlug2",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "CONTAINER_APT_PROXY": "${localEnv:CONTAINER_APT_PROXY}"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "none",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false
    }
  },
  // Persist Claude Code state in a Docker named volume that's independent of
  // the host's ~/.claude config. Survives container rebuilds, isolated from
  // anything the user runs on the host. Symlinks into the volume are wired up
  // by post-create.sh on first boot.
  "mounts": [
    "source=retroplug-claude-state,target=/var/claude-state,type=volume"
  ],
  "runArgs": [
    "--init",
    "--shm-size=512m",
    "--ulimit",
    "memlock=-1:-1"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "anthropic.claude-code"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "cmake.generator": "Unix Makefiles"
      }
    }
  }
}