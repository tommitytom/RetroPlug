# UI source files. Git's binary-file heuristic occasionally trips on UTF-8
# comments (em-dashes, arrows) in our TSX, classifying the file as binary
# and hiding the real diff. Pin them as text so `git diff` and `git blame`
# stay readable.
*.ts    diff
*.tsx   diff
*.js    diff
*.cpp   diff
*.hpp   diff
*.h     diff
*.md    diff

# Goldens compared line for line on every platform: a Windows checkout must not turn them CRLF.
packages/retroplug/test/graph/golden/*.json text eol=lf

# The device-mode test's goldens: the blobs, read in binary and compared with LF-joined hex, and the descriptors,
# compared byte for byte with what the type writes (LF-joined, a newline at the end).
packages/native/test/device-mode/golden/*.hex text eol=lf
packages/native/test/device-mode/golden/*.json text eol=lf
