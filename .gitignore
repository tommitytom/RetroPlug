# build target dir
/bin/
/build/
# sanitizer build dirs (tools/run-sanitizers.sh)
/build-tsan/
/build-asan/
# profiling build dir (tools/run-profile.sh)
/build-prof/

# cmake temp files that remain around
CMakeFiles/
cmake_install.cmake
CMakeCache.txt
Makefile
node_modules
# legacy: bundle now lives under build/ui/
ui/bundle.js
# generic temp files
*.a
*.exe
_dpf_empty.c
lv2_ttl_generator
.claude/settings.local.json

# core dumps
core
core.*

# tools/ Python virtualenv (created by tools/lsdj-manual-setup.sh)
/tools/.venv/

# Python bytecode cache (e.g. from importing tools/reaper-timing-analyze.py)
__pycache__/

# Reaper project fixtures (.rpp) — derived/large; regenerate each from its
# committed .test.ts + author .lua via the matching `make reaper-*-author` target.
*.rpp

# Package test-bundle output (derived: esbuild -> tjs run / native host)
packages/retroplug/.test-build/
packages/retroplug/.native-build/
packages/retroplug/.ui-build/

# macOS Finder metadata
.DS_Store
