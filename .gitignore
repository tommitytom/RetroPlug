# build target dir
/bin/
/build/
# sanitizer build dirs (tools/run-sanitizer.sh)
/build-tsan/
/build-asan/
# profiling build dir (tools/run-profile.sh)
/build-prof/
# aarch64 cross-build dirs + sysroot (leftover build artifacts)
/build-arm/
/build-arm-prof/
/.arm64/

# cmake temp files that remain around
CMakeFiles/
cmake_install.cmake
CMakeCache.txt
/Makefile
node_modules
# generic temp files
*.a
*.exe
_dpf_empty.c
lv2_ttl_generator
.claude/settings.local.json

# core dumps (root only - an unanchored `core` would also swallow any src/core/ directory)
/core
/core.*

# tools/ Python virtualenv (created by tools/lsdj-manual-setup.sh)
/tools/.venv/

# Python bytecode cache (e.g. from importing tools/reaper-timing-analyze.py)
__pycache__/

# Reaper project fixtures (.rpp) - derived/large; regenerate each from its committed
# author .lua via the matching `pnpm reaper:*-author` script (or `pnpm reaper:all`,
# which re-authors every scenario before rendering it).
*.rpp

# Package test-bundle output (derived: esbuild -> tjs run / native host)
packages/retroplug/.test-build/
packages/retroplug/.native-build/
packages/retroplug/.ui-build/

# Per-file test durations, recorded by the runners to dispatch longest-first next run.
# Machine-specific and self-healing (a missing file just costs one unordered run).
packages/retroplug/.test-timings/

# macOS Finder metadata
.DS_Store
