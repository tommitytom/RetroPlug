{
  "name": "@retroplug/core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "type": "module",
  "description": "The node contract (defineNode, its descriptor and settings schema), the graph document, the role contract and the app-contribution contract, with the rp.core node types beside them.",
  "exports": {
    ".": "./ts/index.ts",
    "./canonicalJson": "./ts/canonicalJson.ts",
    "./clock": "./ts/clock.ts",
    "./configFields": "./ts/configFields.ts",
    "./consoles": "./ts/consoles.ts",
    "./constructSpec": "./ts/constructSpec.ts",
    "./defineNode": "./ts/defineNode.ts",
    "./definePackage": "./ts/definePackage.ts",
    "./descriptor": "./ts/descriptor.ts",
    "./graphDocument": "./ts/graphDocument.ts",
    "./midiRoute": "./ts/midiRoute.ts",
    "./midiRouting": "./ts/midiRouting.ts",
    "./offlineJob": "./ts/offlineJob.ts",
    "./platform": "./ts/platform.ts",
    "./ports": "./ts/ports.ts",
    "./protocol": "./ts/protocol.ts",
    "./register": "./ts/register.ts",
    "./romParameters": "./ts/romParameters.ts",
    "./settingsSchema": "./ts/settingsSchema.ts",
    "./systemRoles": "./ts/systemRoles.ts",
    "./ticks": "./ts/ticks.ts"
  },
  "dependencies": {
    "@retroplug/node-sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@retroplug/testing": "workspace:*"
  },
  "retroplug": {
    "native": { "target": "retroplug-core-nodes", "entry": "rp_core_package", "device": true },
    "protocol": {
      "module": "ts/protocol.ts",
      "nodes": [{ "type": "rp.midi.route", "label": 16 }]
    }
  }
}
