{
  "name": "@retroplug/launchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "type": "module",
  "description": "Novation Launchpad support: the protocol (encode, decode, diff), the controller session and its app registry, the port scan and the profiles, and the rp.controller.session script node (span label 22).",
  "exports": {
    ".": "./ts/index.ts",
    "./apps": "./ts/apps/index.ts",
    "./apps/lsdjMidiMap": "./ts/apps/lsdjMidiMap.ts",
    "./controllerSession": "./ts/controllerSession.ts",
    "./decode": "./ts/decode.ts",
    "./enums": "./ts/enums.ts",
    "./portScan": "./ts/portScan.ts",
    "./portable": "./ts/portable.ts",
    "./ports": "./ts/ports.ts",
    "./profile": "./ts/profile.ts",
    "./protocol": "./ts/protocol.ts",
    "./registry": "./ts/registry.ts",
    "./session": "./ts/session.ts",
    "./surface": "./ts/surface.ts",
    "./trackerTarget": "./ts/trackerTarget.ts",
    "./nodes": "./ts/nodes.ts",
    "./testSupport/fakeDevice": "./ts/testSupport/fakeDevice.ts"
  },
  "dependencies": {
    "@retroplug/core": "workspace:*",
    "@retroplug/lsdj": "workspace:*",
    "@retroplug/tracker": "workspace:*"
  },
  "devDependencies": {
    "@retroplug/testing": "workspace:*",
    "typescript": "^7.0.2"
  },
  "retroplug": {
    "protocol": {
      "module": "ts/nodes.ts",
      "nodes": [
        {
          "type": "rp.controller.session",
          "label": 22
        }
      ],
      "roles": {}
    }
  }
}
