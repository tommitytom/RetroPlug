{
  "name": "@retroplug/launchpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "type": "module",
  "description": "Novation Launchpad support: the protocol (encode, decode, diff), the controller session and its app runtime registry, the controllerApps contribution kind, the port scan and the profiles, the rp.controller.session script node, and the project's `controller` section with its control-plane service and the graph placer that places them.",
  "exports": {
    ".": "./ts/index.ts",
    "./apps": "./ts/apps/index.ts",
    "./controllerSession": "./ts/controllerSession.ts",
    "./decode": "./ts/decode.ts",
    "./enums": "./ts/enums.ts",
    "./nodes": "./ts/nodes.ts",
    "./packageContributions": "./ts/packageContributions.ts",
    "./portScan": "./ts/portScan.ts",
    "./portable": "./ts/portable.ts",
    "./ports": "./ts/ports.ts",
    "./profile": "./ts/profile.ts",
    "./protocol": "./ts/protocol.ts",
    "./registry": "./ts/registry.ts",
    "./session": "./ts/session.ts",
    "./surface": "./ts/surface.ts",
    "./testSupport/fakeDevice": "./ts/testSupport/fakeDevice.ts",
    "./launchTarget": "./ts/launchTarget.ts",
    "./client": "./ts/client.ts",
    "./ui": "./ts/ui/index.ts",
    "./cli": "./ts/cli/index.ts",
    "./app": "./ts/control/index.ts",
    "./kind": "./ts/control/kind.ts",
    "./placer": "./ts/control/placer.ts",
    "./projectSection": "./ts/control/projectSection.ts",
    "./projectService": "./ts/control/projectService.ts"
  },
  "dependencies": {
    "@retroplug/core": "workspace:*",
    "@retroplug/node-sdk": "workspace:*",
    "@retroplug/tracker": "workspace:*",
    "@retroplug/ui": "workspace:*"
  },
  "devDependencies": {
    "@retroplug/testing": "workspace:*",
    "typescript": "^7.0.2"
  },
  "retroplug": {
    "app": "ts/control/index.ts",
    "ui": "ts/ui/index.ts",
    "protocol": {
      "module": "ts/nodes.ts",
      "placer": "ts/control/placer.ts",
      "nodes": [
        {
          "type": "rp.controller.session",
          "label": 22
        }
      ],
      "roles": {}
    },
    "native": [
      { "target": "retroplug-launchpad", "entry": "rp_launchpad_package", "device": true },
      {
        "target": "retroplug-launchpad-desktop",
        "device": false,
        "provider": "rp_launchpad_provider",
        "rpc": { "header": "launchpad/desktop/LaunchpadRpc.hpp", "register": "rp::launchpad::registerRpc" }
      }
    ],
    "cli": "ts/cli/index.ts",
    "kinds": {
      "controllerApps": {
        "control": "ts/control/kind.ts",
        "runtime": {
          "module": "ts/apps/index.ts",
          "register": "registerControllerApps",
          "type": "ControllerAppRuntime"
        },
        "data": [
          "syncOverride"
        ]
      }
    }
  }
}
