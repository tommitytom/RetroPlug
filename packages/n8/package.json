{
  "name": "@retroplug/n8",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "type": "module",
  "description": "The Everdrive N8 Pro: the rp.n8.nes node type, the Edio protocol, the cart's link and the desktop's serial host around it, plus the NES host-MIDI half of the app - the nes-n8-midi role, the ROM provider that attaches it to every NES, and the rp.n8.midi-to-fifo node (span label 18) that runs it on the audio thread.",
  "exports": {
    ".": "./ts/index.ts",
    "./app": "./ts/app.ts",
    "./consoles": "./ts/consoles.ts",
    "./n8MidiToFifoNode": "./ts/n8MidiToFifoNode.ts",
    "./protocol": "./ts/protocol.ts",
    "./ui": "./ts/ui/index.ts",
    "./cli": "./ts/cli/index.ts",
    "./bridge": "./ts/bridge.ts"
  },
  "dependencies": {
    "@retroplug/core": "workspace:*",
    "@retroplug/n8-wire": "workspace:*",
    "@retroplug/node-sdk": "workspace:*",
    "@retroplug/tracker": "workspace:*",
    "@retroplug/ui": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@retroplug/testing": "workspace:*"
  },
  "retroplug": {
    "app": "ts/app.ts",
    "ui": "ts/ui/index.ts",
    "consoles": "ts/consoles.ts",
    "protocol": {
      "module": "ts/protocol.ts",
      "nodes": [{ "type": "rp.n8.midi-to-fifo", "label": 18, "midiIn": "midiIn", "writes": ["midi"] }],
      "roles": { "nes-n8-midi": "rp.n8.midi-to-fifo" }
    },
    "native": [
      { "target": "retroplug-n8", "entry": "rp_n8_package", "device": true },
      {
        "target": "retroplug-n8-desktop",
        "device": false,
        "provider": "rp_n8_provider",
        "rpc": { "header": "n8/desktop/N8Rpc.hpp", "register": "rp::n8::registerRpc" }
      }
    ],
    "cli": "ts/cli/index.ts"
  }
}
