{
  "name": "@retroplug/retroplug",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TS-first reimplementation of RetroPlug's orchestration layer (project/systems/paths/recent/config/SRAM/kits), developed test-driven against a mocked native backend. No C++ in the loop — see README.",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node scripts/lib/packages.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.ui.json"
  },
  "dependencies": {
    "@retroplug/bliptoaster": "workspace:*",
    "@retroplug/core": "workspace:*",
    "@retroplug/dsp": "workspace:*",
    "@retroplug/lsdj": "workspace:*",
    "@retroplug/lsdj-launchpad": "workspace:*",
    "@retroplug/mesen": "workspace:*",
    "@retroplug/mgb": "workspace:*",
    "@retroplug/sameboy": "workspace:*",
    "@retroplug/tracker": "workspace:*",
    "@retroplug/n8": "workspace:*",
    "@retroplug/risa": "workspace:*",
    "@retroplug/smsggdj": "workspace:*",
    "@retroplug/launchpad": "workspace:*",
    "@retroplug/host-io": "workspace:*",
    "@retroplug/system": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@retroplug/testing": "workspace:*",
    "typescript": "^7.0.2"
  },
  "retroplug": {
    "app": "src/app.ts"
  }
}
