{
  "name": "@retroplug/alpha",
  "exports": {
    "./app": "./ts/app.ts",
    "./consoles": "./ts/consoles.ts",
    "./nodes": "./ts/nodes.ts",
    "./appRuntime": "./ts/appRuntime.ts",
    "./placer": "./ts/placer.ts",
    "./ui": "./ts/ui/index.ts",
    "./kind": "./ts/widgetKind.ts",
    "./widgets": "./ts/widgets.ts"
  },
  "private": true,
  "retroplug": {
    "app": "ts/app.ts",
    "consoles": "ts/consoles.ts",
    "ui": "ts/ui/index.ts",
    "protocol": {
      "module": "ts/nodes.ts",
      "placer": "ts/placer.ts",
      "nodes": [
        {
          "type": "rp.alpha.midi",
          "label": 16,
          "midiIn": "midi",
          "writes": [
            "serialIn"
          ]
        }
      ],
      "roles": {
        "alpha-midi": "rp.alpha.midi"
      },
      "kinds": {
        "controllerApps": [
          {
            "id": "alpha-app",
            "module": "ts/appRuntime.ts",
            "syncOverride": {
              "node": "rp.alpha.midi",
              "mode": "midiMap",
              "listening": "MidiMap",
              "off": "off"
            }
          }
        ]
      }
    },
    "kinds": {
      "widgets": {
        "control": "ts/widgetKind.ts",
        "runtime": {
          "module": "ts/widgets.ts",
          "register": "registerWidgets",
          "type": "WidgetRuntime"
        },
        "data": [
          "mode"
        ]
      }
    }
  }
}
