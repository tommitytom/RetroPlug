{
  "name": "@retroplug/beta",
  "exports": {
    "./app": "./ts/app.ts",
    "./consoles": "./ts/consoles.ts",
    "./kind": "./ts/kind.ts",
    "./apps": "./ts/apps.ts",
    "./widgetRuntime": "./ts/widgetRuntime.ts"
  },
  "private": true,
  "dependencies": {
    "@retroplug/alpha": "workspace:*"
  },
  "retroplug": {
    "app": "ts/app.ts",
    "consoles": "ts/consoles.ts",
    "kinds": {
      "controllerApps": {
        "control": "ts/kind.ts",
        "runtime": {
          "module": "ts/apps.ts",
          "register": "registerControllerApps",
          "type": "ControllerAppRuntime"
        },
        "data": [
          "syncOverride"
        ]
      }
    }
  }
}
