{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": ["ES2020", "DOM"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "paths": {
            "lvgljs-ui":            ["../dpf.js/deps/lv_binding_js/src/render/react"],
            "lvgljs":               ["../dpf.js/runtime/lvgljs"],
            "react":                ["../dpf.js/deps/lv_binding_js/node_modules/@types/react"],
            "react/jsx-runtime":    ["../dpf.js/deps/lv_binding_js/node_modules/@types/react/jsx-runtime"],
            "@rpcpp/createClient":  ["../dpf.js/deps/rpcpp/clients/typescript/client/src/createClient"],
            "@rpcpp/codec":         ["../dpf.js/deps/rpcpp/clients/typescript/client/src/codec"],
            "@rpcpp/transport":     ["../dpf.js/deps/rpcpp/clients/typescript/client/src/transport"],
            "plugin-service":       ["./build/ui/generated/PluginService.ts"]
        }
    }
}
