{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": ["ES2020", "DOM"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "paths": {
            "lvgljs-ui": ["../deps/lv_binding_js/src/render/react"],
            "lvgljs":    ["../runtime/lvgljs"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", "../runtime/**/*.ts", "../runtime/**/*.tsx"],
    "exclude": ["bundle.js", "node_modules"]
}
